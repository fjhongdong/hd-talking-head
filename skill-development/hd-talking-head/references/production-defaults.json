{
  "schema_version": 1,
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 24
  },
  "opening": {
    "policy": "static_cover_prefix",
    "hold_frames": 12,
    "transition_frames": 0,
    "poster_role": "platform_poster_and_static_opening"
  },
  "background_music": false,
  "visual_coverage": {
    "target_percent": 60,
    "floor_percent": 55,
    "first_broll_seconds": 15,
    "max_gap_seconds": 15
  },
  "aroll_overlay": {
    "font_family": "PingFang SC, sans-serif",
    "foreground": "#242a2d",
    "surface": "#fff8e8",
    "accent": "#c79a36",
    "border_color": "#bdb59d",
    "title": {
      "font_size": 64,
      "font_weight": 800,
      "line_height": 1.25,
      "letter_spacing": 0
    },
    "body": {
      "font_size": 48
    },
    "card_family": {
      "border_radius": 22,
      "padding_x": 22,
      "padding_y": 12,
      "min_height": 108,
      "gap": 14
    },
    "layout": {
      "left": 80,
      "top": 70,
      "available_width": 920,
      "content_width": 860
    }
  },
  "concurrency": {
    "independent_preparations": 3,
    "shared_media_generations": 2,
    "local_heavy_renders": 1
  },
  "motion_text": {
    "target_font_px": {
      "title": 64,
      "body": 48
    },
    "minimum_ocr_line_height_px": {
      "title": 48,
      "body": 36
    },
    "minimum_ocr_confidence": 0.45,
    "sample_step_seconds": 1.0
  }
}
